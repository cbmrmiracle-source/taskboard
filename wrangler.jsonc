{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taskboard",
      // Replace with the id printed by `npx wrangler d1 create taskboard`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Checks for due reminders once a minute
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Apple requires a real contact address for push notifications
    "VAPID_SUBJECT": "mailto:cb.mrmiracle@gmail.com"
  },
  "observability": { "enabled": true }
}
